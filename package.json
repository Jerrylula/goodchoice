{
  "name": "ore-nine-arc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "deploy:mainnet": "node scripts/deploy.mjs",
    "build": "npm run compile && tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "cross-env TEST_EVM=shanghai node scripts/compile.mjs && node --test test/round.test.mjs"
  },
  "dependencies": {
    "@d20dao/vrf-sdk": "0.4.0",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "cross-env": "7.0.3",
    "ganache": "7.9.2",
    "solc": "0.8.28",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "wrangler": "4.140.0"
  }
}
